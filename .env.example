DJANGO_ENV=dev
DJANGO_SITE_ID=1
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost
# Trust X-Forwarded-For only behind a known reverse proxy.
DJANGO_TRUST_X_FORWARDED_FOR=0
DJANGO_TRUSTED_PROXY_IPS=
REACT_SPA_DEV_SERVER_URL=
REACT_SPA_ENTRY=index.html
REACT_SPA_MANIFEST_PATH=frontend-react/dist/.vite/manifest.json
SEO_CANONICAL_HOST=
SEO_CANONICAL_SCHEME=https
DJANGO_DB_ENGINE=django.db.backends.sqlite3
DJANGO_DB_NAME=db.sqlite3
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=1
DJANGO_EMAIL_HOST_USER=example@gmail.com
DJANGO_EMAIL_HOST_PASSWORD=example-password
DJANGO_DEFAULT_FROM_EMAIL=Dominium <example@gmail.com>
GOOGLE_CLIENT_ID=google-app-id
GOOGLE_CLIENT_SECRET=google-app-secret
TELEGRAM_BOT_TOKEN=telegram-token
TELEGRAM_CHAT_IDS=123456789
REQUESTS_TIMEOUT=10
# URL import security (recommended strict mode).
# Add CRM page domains (listing URLs):
IMPORT_REQUIRE_ALLOWED_HOSTS=1
IMPORT_ALLOWED_HOSTS=dom.ria.com,www.dom.ria.com
# Add CDN/static domains used for listing images. If empty, IMPORT_ALLOWED_HOSTS is used.
IMPORT_ALLOWED_IMAGE_HOSTS=cdn.riastatic.com,*.riastatic.com
IMPORT_ALLOW_PRIVATE_HOSTS=0
IMPORT_MAX_HTML_BYTES=2097152
IMPORT_MAX_IMAGE_BYTES=12582912
IMPORT_HTTP_REDIRECT_LIMIT=3
IMPORT_IMAGE_PHASH_THRESHOLD=4
EXCHANGE_RATES_URL=https://api.privatbank.ua/p24api/pubinfo?exchange&json&coursid=11
EXCHANGE_RATES_CACHE_SECONDS=1800
CONSULTATION_RATE_LIMIT=5
CONSULTATION_RATE_WINDOW=600
IMPORT_RATE_LIMIT=5
IMPORT_RATE_WINDOW=60
LOGIN_RATE_LIMIT=8
LOGIN_RATE_WINDOW=300
ADMIN_IMAGE_UPLOAD_MAX_FILES=20
ADMIN_IMAGE_MAX_BYTES=8388608
DJANGO_ALLOW_MANUAL_AUTH=0
DJANGO_ACCOUNT_PREVENT_ENUMERATION=1
DJANGO_ACCOUNT_EMAIL_VERIFICATION=optional
DJANGO_ACCOUNT_EMAIL_REQUIRED=0
DJANGO_SOCIALACCOUNT_LOGIN_ON_GET=1
DJANGO_SOCIALACCOUNT_AUTO_SIGNUP=1
HOME_CACHE_SECONDS=300
SEARCH_CACHE_SECONDS=60
DJANGO_DRF_ANON_THROTTLE=60/min
DJANGO_DRF_USER_THROTTLE=240/min
DJANGO_SANITIZE_ALLOWED_TAGS=p,br,b,strong,i,em,u,ul,ol,li,a
DJANGO_SANITIZE_ALLOWED_SCHEMES=http,https,mailto,tel
DJANGO_SANITIZE_CLEAN_CONTENT_TAGS=script,style,iframe,object,embed
DJANGO_PERMISSIONS_POLICY=camera=(), microphone=(), payment=(), usb=(), geolocation=(), fullscreen=(), clipboard-write=(self), web-share=(self)
DJANGO_CROSS_ORIGIN_RESOURCE_POLICY=same-site
DJANGO_X_PERMITTED_CROSS_DOMAIN_POLICIES=none
DJANGO_ORIGIN_AGENT_CLUSTER=?1
DJANGO_CONTENT_SECURITY_POLICY=
DJANGO_CSP_STRICT_REPORT_ONLY=1
DJANGO_CSP_REPORT_URI=/_csp/report/
DJANGO_CSP_REPORT_RATE_LIMIT=120
DJANGO_CSP_REPORT_RATE_WINDOW=60
DJANGO_CONTENT_SECURITY_POLICY_REPORT_ONLY=

# Realtsoft CRM Integration
REALTSOFT_CRM_URL=https://crm-dominium.realtsoft.net
REALTSOFT_API_KEY=your-api-key
REALTSOFT_SECRET_KEY=your-secret-key
REALTSOFT_SYNC_ENABLED=0
REALTSOFT_DEFAULT_PER_PAGE=150
